import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/deviceCapabilities.bs"
import "pkg:/source/utils/misc.bs"

' Asks the server how it would play this item with the tracks the screen has
' selected, which is all the direct play line in the details footer needs to know.
'
' This deliberately does not go through the playback path. That one negotiates
' codecs, opens a live stream and takes the current session over, none of which a
' details screen should set in motion just to print a word.

sub init()
    m.top.functionName = "probeDirectPlay"
end sub

sub probeDirectPlay()
    if not isValidAndNotEmpty(m.top.itemId)
        m.top.result = { state: "empty", supportsDirectPlay: false }
        return
    end if

    params = {
        "UserId": m.global.session.user.id,
        "MaxStreamingBitrate": "140000000",
        "MaxStaticBitrate": "140000000"
    }
    if isValidAndNotEmpty(m.top.mediaSourceId) then params.MediaSourceId = m.top.mediaSourceId
    if m.top.audioStreamIndex > -1 then params.AudioStreamIndex = m.top.audioStreamIndex
    if m.top.subtitleStreamIndex > -1 then params.SubtitleStreamIndex = m.top.subtitleStreamIndex

    ' Asked without a profile the server answers that it supports everything, so
    ' the line would read as direct play for every title on every set
    body = {
        "DeviceProfile": getDeviceProfile(),
        "EnableDirectPlay": true,
        "EnableDirectStream": true,
        "EnableTranscoding": true
    }

    req = APIRequest(Substitute("Items/{0}/PlaybackInfo", m.top.itemId), params)
    req.SetRequest("POST")
    resp = postJson(req, FormatJson(body))

    if not isValid(resp) or not isValidAndNotEmpty(resp.MediaSources)
        m.top.result = { state: "failed", supportsDirectPlay: false }
        return
    end if

    source = resp.MediaSources[0]
    if isValidAndNotEmpty(m.top.mediaSourceId)
        for each candidate in resp.MediaSources
            if isValid(candidate.Id) and candidate.Id = m.top.mediaSourceId
                source = candidate
                exit for
            end if
        end for
    end if

    if not isValid(source)
        m.top.result = { state: "empty", supportsDirectPlay: false }
        return
    end if

    m.top.result = { state: "ready", supportsDirectPlay: source.SupportsDirectPlay = true }
end sub
