import "pkg:/components/setup/setupPreviewDraw.bs"

' Miniature detail screens, one per style the picker offers.

' How far the scrims are taken on the two artwork-first styles, which show more of the picture
' than the cinematic one does
const DETAIL_PREVIEW_SCRIM = 148

sub init()
    redraw()
end sub

sub redraw()
    while m.top.getChildCount() > 0
        m.top.removeChildIndex(0)
    end while

    pal = setupPreviewDraw.Palette()
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, pal.background)

    style = LCase(m.top.variant)
    if style = "classic"
        drawClassic(pal)
    else if style = "spotlight"
        drawSpotlight(pal)
    else if style = "nouveau"
        drawNouveau(pal)
    else if style = "minimalist"
        drawMinimalist(pal)
    else
        drawModern(pal)
    end if
end sub

' One page over a dimmed backdrop: logo and facts down the left, the rounded poster in the top
' right corner, the metadata card underneath
sub drawClassic(pal as object)
    items = m.top.items
    drawBackdrop(pal)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x000000C8")

    poster = setupPreviewDraw.ItemField(items, 0, "posterUrl")
    setupPreviewDraw.Art(m.top, 1585, 140, 239, 360, poster, pal.surfaceVariant)

    setupPreviewDraw.Logo(m.top, items, 0, 96, 130, 507, 116, pal.onSurface)

    setupPreviewDraw.Rect(m.top, 96, 282, 60, 22, pal.onSurfaceDim)
    setupPreviewDraw.Rect(m.top, 180, 278, 64, 30, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 268, 282, 70, 22, pal.onSurfaceDim)
    setupPreviewDraw.Icon(m.top, "pkg:/images/sharp_star_white_18dp.png", 362, 280, 24, "0xFFD700FF")
    setupPreviewDraw.Rect(m.top, 394, 282, 46, 22, pal.onSurfaceDim)
    setupPreviewDraw.Icon(m.top, "pkg:/images/fresh.png", 464, 280, 24, "0xFFFFFFFF")
    setupPreviewDraw.Rect(m.top, 496, 282, 46, 22, pal.onSurfaceDim)

    setupPreviewDraw.Rect(m.top, 96, 344, 900, 22, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 96, 378, 760, 22, pal.onSurfaceFaint)

    ' The classic action row sits centered on the screen
    drawButtonRow(pal, 662, 444, ["heart.png", "check_white.png", "detail_trailer.png", "detail_shuffle.png"])

    setupPreviewDraw.Rect(m.top, 96, 570, 1728, 330, "0xFFFFFF0D")
    for column = 0 to 2
        x = 160 + column * 560
        setupPreviewDraw.Rect(m.top, x, 614, 130, 20, pal.onSurfaceDim)
        setupPreviewDraw.Rect(m.top, x, 662, 320, 18, pal.onSurfaceFaint)
        setupPreviewDraw.Rect(m.top, x, 696, 260, 18, pal.onSurfaceFaint)
    end for
end sub

' Cinematic: full bleed art, scrims darkening the left and bottom, the text block top left,
' buttons and the tab strip below
sub drawModern(pal as object)
    drawBackdrop(pal)
    drawScrim("pkg:/images/sidebar-edge-gradient.png", 0, 0, 1400, 1080, "0x000000", 255)
    setupPreviewDraw.Gradient(m.top, 0, 640, 1920, 440, 217)

    setupPreviewDraw.Logo(m.top, m.top.items, 0, 96, 130, 500, 200, pal.onSurface)
    for i = 0 to 3
        setupPreviewDraw.Rect(m.top, 96 + i * 126, 380, 110, 40, pal.onSurfaceDim)
    end for
    setupPreviewDraw.Rect(m.top, 96, 452, 900, 22, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 96, 486, 760, 22, pal.onSurfaceFaint)

    drawButtonRow(pal, 96, 560, ["heart.png", "check_white.png", "detail_trailer.png", "detail_shuffle.png"])

    for i = 0 to 3
        color = pal.onSurfaceFaint
        if i = 0 then color = pal.onSurface
        setupPreviewDraw.Rect(m.top, 96 + i * 180, 980, 140, 30, color)
    end for
    setupPreviewDraw.Rect(m.top, 96, 1024, 140, 6, pal.accent)
end sub

' Artwork first: the hero sits high on the picture and a band of summary cards under it names
' what each one opens
sub drawSpotlight(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 640, 440)

    setupPreviewDraw.Logo(m.top, m.top.items, 0, 80, 142, 600, 150, pal.onSurface)
    drawFactsRow(pal, 80, 312)
    setupPreviewDraw.Icon(m.top, "pkg:/images/sharp_star_white_18dp.png", 80, 350, 30, "0xFFD700FF")
    setupPreviewDraw.Rect(m.top, 120, 356, 70, 22, pal.onSurfaceDim)

    setupPreviewDraw.Rect(m.top, 80, 396, 1500, 22, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 80, 437, 1340, 22, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 80, 478, 1080, 22, pal.onSurfaceFaint)

    drawButtonRow(pal, 80, 559, ["heart.png", "check_white.png", "dotDotDot.png"], 400, 108, 108)

    for i = 0 to 2
        x = 80 + i * 412
        setupPreviewDraw.Rect(m.top, x, 723, 380, 216, "0xFFFFFF10")
        setupPreviewDraw.Rect(m.top, x + 28, 830, 250, 24, pal.onSurfaceDim)
        setupPreviewDraw.Rect(m.top, x + 28, 870, 160, 20, pal.onSurfaceFaint)
    end for
end sub

' Every section stacked down one page, so the hero is shallow and two rails already sit under it
sub drawNouveau(pal as object)
    drawBackdrop(pal)
    drawArtworkScrims(pal, 500, 580)

    setupPreviewDraw.Logo(m.top, m.top.items, 0, 80, 96, 520, 124, pal.onSurface)
    drawFactsRow(pal, 80, 236)
    setupPreviewDraw.Icon(m.top, "pkg:/images/sharp_star_white_18dp.png", 80, 274, 30, "0xFFD700FF")
    setupPreviewDraw.Rect(m.top, 120, 280, 70, 22, pal.onSurfaceDim)

    setupPreviewDraw.Rect(m.top, 80, 320, 1420, 20, pal.onSurfaceFaint)
    setupPreviewDraw.Rect(m.top, 80, 358, 1180, 20, pal.onSurfaceFaint)

    drawButtonRow(pal, 80, 424, ["heart.png", "dotDotDot.png"], 340, 92, 92)

    drawRail(pal, 552, 5, 192, 108)
    drawRail(pal, 740, 7, 108, 162)
end sub

' Mostly picture, with the title, one play button and the episodes along the bottom
sub drawMinimalist(pal as object)
    drawBackdrop(pal)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x0000008C")

    setupPreviewDraw.Logo(m.top, m.top.items, 0, 56, 639, 440, 104, pal.onSurface)
    drawButtonRow(pal, 56, 771, ["detail_shuffle.png", "heart.png"], 300, 92, 92)

    for i = 0 to 3
        setupPreviewDraw.Rect(m.top, 56 + i * 256, 899, 236, 133, "0xFFFFFF29")
    end for
end sub

' ===== Pieces the styles share =====

sub drawBackdrop(pal as object)
    backdrop = setupPreviewDraw.ItemField(m.top.items, 0, "backdropUrl")
    setupPreviewDraw.Art(m.top, 0, 0, 1920, 1080, backdrop, pal.surfaceVariant)
end sub

sub drawScrim(uri as string, x as float, y as float, width as float, height as float, blend as string, alpha as integer)
    scrim = m.top.createChild("Poster")
    scrim.translation = [x, y]
    scrim.width = width
    scrim.height = height
    scrim.loadDisplayMode = "scaleToFill"
    scrim.blendColor = blend
    scrim.opacity = alpha / 255
    scrim.uri = uri
end sub

' The wash and the two fades the artwork-first styles lay over the picture. They blend with the
' page colour rather than with black, the way the real screens do, so the picture keeps its colour
sub drawArtworkScrims(pal as object, fadeY as float, fadeHeight as float)
    setupPreviewDraw.Rect(m.top, 0, 0, 1920, 1080, "0x00000052")
    drawScrim("pkg:/images/sidebar-edge-gradient.png", 0, 0, 1400, 1080, pal.background, DETAIL_PREVIEW_SCRIM)
    drawScrim("pkg:/images/seerr_gradient.png", 0, fadeY, 1920, fadeHeight, pal.background, DETAIL_PREVIEW_SCRIM)
end sub

' Year, rating and a couple of genres, run together the way the real facts line runs
sub drawFactsRow(pal as object, x as float, y as float)
    widths = [70, 60, 150, 120]
    at = x
    for each width in widths
        setupPreviewDraw.Rect(m.top, at, y, width, 24, pal.onSurfaceDim)
        at += width + 32
    end for
end sub

sub drawRail(pal as object, y as float, count as integer, cardWidth as float, cardHeight as float)
    setupPreviewDraw.Rect(m.top, 80, y, 240, 24, pal.onSurfaceDim)
    for i = 0 to count - 1
        color = i = 0 ? "0xFFFFFF47" : "0xFFFFFF24"
        setupPreviewDraw.Rect(m.top, 80 + i * (cardWidth + 20), y + 44, cardWidth, cardHeight, color)
    end for
end sub

' The real action row: a play pill leading, then icon buttons beside it
sub drawButtonRow(pal as object, x as float, y as float, icons as object, pillWidth = 220 as float, pillHeight = 64 as float, circleWidth = 76 as float)
    playIcon = pillHeight * 0.5625
    circleIcon = pillHeight * 0.5

    setupPreviewDraw.Rect(m.top, x, y, pillWidth, pillHeight, pal.accent)
    setupPreviewDraw.Icon(m.top, "pkg:/images/icons/detail_play.png", x + 22, y + (pillHeight - playIcon) / 2, playIcon, pal.onAccent)
    setupPreviewDraw.Rect(m.top, x + 38 + playIcon, y + (pillHeight - 20) / 2, pillWidth * 0.5, 20, pal.onAccent)

    index = 0
    for each icon in icons
        bx = x + pillWidth + 24 + index * (circleWidth + 16)
        setupPreviewDraw.Rect(m.top, bx, y, circleWidth, pillHeight, pal.onSurfaceFaint)
        setupPreviewDraw.Icon(m.top, `pkg:/images/icons/${icon}`, bx + (circleWidth - circleIcon) / 2, y + (pillHeight - circleIcon) / 2, circleIcon, pal.onSurfaceDim)
        index++
    end for
end sub
