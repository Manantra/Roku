import "pkg:/source/api/baserequest.bs"
import "pkg:/source/utils/achievementsModel.bs"
import "pkg:/source/utils/misc.bs"

' Client for the Achievement Badges plugin, which is a server plugin of its own, so it lives
' under /Plugins/AchievementBadges and is probed separately.
'
' Nothing here throws. A server without the plugin answers 404 on every route, and a panel that
' asked for everything at once and got nothing back wants an empty screen rather than a pile of
' errors, so a failed call reads as no answer. Nothing here polls, and the login ping, the quest
' reroll and spending a power-up are the only writes.

const ACHIEVEMENTS_ROOT = "/Plugins/AchievementBadges"
' What the panel opens on, so the screen that can change it knows what it was handed
const ACHIEVEMENTS_DEFAULT_PERIOD = "month"

namespace achievements

    function Request(path as string, params = {} as object) as dynamic
        req = APIRequest(`${ACHIEVEMENTS_ROOT}/${path}`, params)
        if not isValid(req) then return invalid

        return getJson(req)
    end function

    function GetMap(path as string, params = {} as object) as dynamic
        data = Request(path, params)
        return achievementsModel.IsObject(data) ? data : invalid
    end function

    function GetList(path as string, params = {} as object) as object
        data = Request(path, params)
        if not isValidAndNotEmpty(data) then return []
        if LCase(type(data)) <> "roarray" then return []
        return data
    end function

    ' What the admin left switched on, as the last probe found it. Both stay on until the server
    ' says otherwise, since a plugin too old to report them still serves them.
    function Flags() as object
        info = chainLookupReturn(m.global, "session.achievementsInfo", invalid)
        if not isValid(info) then return { available: false, leaderboardEnabled: true, questsEnabled: true }
        return info
    end function

    function IsAvailable() as boolean
        return Flags().available = true
    end function

    ' Whether the plugin answered here. public-config needs no administrator, so an ordinary
    ' user gets the same answer, and a server without the plugin has no such route.
    function Probe() as object
        config = GetMap("public-config")
        if not isValid(config)
            return { available: false, leaderboardEnabled: true, questsEnabled: true }
        end if

        return {
            available: true,
            leaderboardEnabled: achievementsModel.Field(config, "LeaderboardEnabled") <> false,
            questsEnabled: achievementsModel.Field(config, "QuestsEnabled") <> false
        }
    end function

    ' Writes to a path and tells a refusal apart from a fault. refusedWith is the status the
    ' plugin answers when it means no, so that one comes back with whatever the plugin said, and
    ' anything else reads as a plain failure.
    function Post(path as string, refusedWith = 0 as integer) as object
        req = APIRequest(`${ACHIEVEMENTS_ROOT}/${path}`)
        if not isValid(req) then return {}

        started = diagnostics.StartTrace("POST", req)
        req.SetRequest("POST")
        req.setMessagePort(CreateObject("roMessagePort"))
        req.AddHeader("Content-Type", "application/json")
        req.AsyncPostFromString("")

        event = wait(30000, req.GetMessagePort())
        if type(event) <> "roUrlEvent"
            diagnostics.EndTrace(started, "timed out", diagnostics.LEVEL_ERROR)
            return {}
        end if

        status = event.GetResponseCode()
        answered = status >= 200 and status < 300
        diagnostics.EndTrace(started, status.ToStr(), answered ? diagnostics.LEVEL_DEBUG : diagnostics.LEVEL_WARN)

        body = invalid
        text = event.GetString()
        if text <> "" then body = ParseJson(text)

        if answered then return { body: achievementsModel.IsObject(body) ? body : invalid }
        if status <> refusedWith then return {}

        return { refused: true, message: achievementsModel.AsString(achievementsModel.Field(body, "Message")) }
    end function

    ' What keeps a daily login streak alive. Nothing reads the answer.
    sub SendLoginPing()
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) then return

        Post(`users/${userId}/login-ping`)
    end sub

    ' Swaps one quest set for a fresh one. The plugin answers 429 once that allowance is spent.
    function RerollQuests(weekly as boolean) as object
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) then return { outcome: REROLL_FAILED }

        questSet = weekly ? "weekly" : "daily"
        written = Post(`users/${userId}/quests/${questSet}/reroll`, 429)

        if written.refused = true then return { outcome: REROLL_ALREADY_USED }
        if not achievementsModel.IsObject(written.body) then return { outcome: REROLL_FAILED }

        fresh = achievementsModel.ParseRerolledQuests(written.body)
        return { outcome: REROLLED, quests: fresh.quests, rerollsLeft: fresh.rerollsLeft }
    end function

    function FetchPowerUps() as dynamic
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) then return invalid

        json = GetMap(`users/${userId}/powerups`)
        if not isValid(json) then return invalid

        return achievementsModel.ParsePowerUpState(json)
    end function

    ' Spends one power-up. The plugin refuses with 400 when the slot is empty or the boost is
    ' already running, and its own wording explains which better than a guess here would.
    function UsePowerUp(powerUpType as string) as object
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) or not isValidAndNotEmpty(powerUpType) then return { outcome: POWER_UP_FAILED }

        written = Post(`users/${userId}/powerups/use/${powerUpType}`, 400)

        if written.refused = true then return { outcome: POWER_UP_REFUSED, message: written.message }
        if not achievementsModel.IsObject(written.body) then return { outcome: POWER_UP_FAILED }

        return {
            outcome: POWER_UP_USED,
            slots: achievementsModel.ParsePowerUpSlots(achievementsModel.Field(written.body, "Inventory"))
        }
    end function

    function FetchLeaderboard(category = "" as string, limit = 10 as integer) as object
        if not Flags().leaderboardEnabled then return []

        path = "leaderboard"
        if category <> "" then path = `leaderboard/${category}`
        return achievementsModel.ParseLeaderboard(GetList(path, { limit: limit }))
    end function

    ' What the plugin suggests watching to move a badge along. The server picks unplayed items
    ' that match the badge's metric, so a badge measured on something it cant query comes back
    ' with nothing.
    function FetchBadgeChase(badgeId as string, limit = 10 as integer) as dynamic
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) or not isValidAndNotEmpty(badgeId) then return invalid

        json = GetMap(`users/${userId}/chase/${badgeId}`, { limit: limit })
        if not isValid(json) then return invalid

        return achievementsModel.ParseBadgeChase(json)
    end function

    function FetchRecap(period as string) as dynamic
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) then return invalid

        return achievementsModel.ParseRecap(GetMap(`users/${userId}/recap`, { period: period }))
    end function

    ' Everything the panel opens with. A section the admin switched off is not requested at all
    ' rather than fetched and thrown away.
    function LoadOverview() as dynamic
        userId = chainLookupReturn(m.global, "session.user.id", "")
        if not isValidAndNotEmpty(userId) then return invalid

        config = Flags()
        summary = GetMap(`users/${userId}/summary`)
        rank = GetMap(`users/${userId}/rank`)
        badges = achievementsModel.ParseBadges(GetList(`users/${userId}`))

        ' A server that answered none of it has lost the plugin, rather than holding an empty
        ' profile
        if not isValid(summary) and badges.count() = 0 and not isValid(rank) then return invalid

        quests = invalid
        if config.questsEnabled then quests = achievementsModel.ParseQuests(GetMap(`users/${userId}/quests`))

        leaderboard = []
        if config.leaderboardEnabled then leaderboard = FetchLeaderboard()

        return {
            summary: achievementsModel.ParseSummary(summary),
            rank: achievementsModel.ParseRank(rank),
            badges: badges,
            equipped: achievementsModel.ParseBadges(GetList(`users/${userId}/equipped`)),
            quests: quests,
            leaderboard: leaderboard,
            recap: achievementsModel.ParseRecap(GetMap(`users/${userId}/recap`, { period: ACHIEVEMENTS_DEFAULT_PERIOD })),
            libraryCompletion: achievementsModel.ParseLibraryCompletion(GetMap(`users/${userId}/library-completion`)),
            leaderboardEnabled: config.leaderboardEnabled,
            questsEnabled: config.questsEnabled
        }
    end function

end namespace
