import "pkg:/source/api/Achievements.bs"
import "pkg:/source/utils/misc.bs"

' The panel asks for everything at once when it opens, and the leaderboard, the recap, a badge,
' the activity feed, the loadout, the shop and what the viewer spends ask again as they work. All
' of it goes over the network, so none of it runs on the render thread.

sub init()
    m.top.functionName = "loadAchievements"
end sub

sub loadAchievements()
    request = m.top.request
    kind = chainLookupReturn(request, "kind", "overview")

    if kind = "leaderboard"
        m.top.result = { kind: kind, entries: achievements.FetchLeaderboard(request.category) }
        return
    end if

    if kind = "recap"
        m.top.result = { kind: kind, recap: achievements.FetchRecap(request.period) }
        return
    end if

    if kind = "chase"
        m.top.result = { kind: kind, chase: achievements.FetchBadgeChase(request.badgeId) }
        return
    end if

    if kind = "activity"
        m.top.result = { kind: kind, activity: achievements.FetchActivity() }
        return
    end if

    if kind = "powerups"
        m.top.result = { kind: kind, powerUps: achievements.FetchPowerUps() }
        return
    end if

    ' The catalogue carries no bank, so the two are read together
    if kind = "shop"
        m.top.result = { kind: kind, items: achievements.FetchShopPowerUps(), powerUps: achievements.FetchPowerUps() }
        return
    end if

    if kind = "buy"
        m.top.result = { kind: kind, purchase: achievements.BuyShopItem(request.itemId) }
        return
    end if

    if kind = "usePowerUp"
        m.top.result = { kind: kind, spend: achievements.UsePowerUp(request.powerUpType) }
        return
    end if

    if kind = "reroll"
        m.top.result = { kind: kind, weekly: request.weekly, reroll: achievements.RerollQuests(request.weekly) }
        return
    end if

    m.top.result = { kind: "overview", overview: achievements.LoadOverview() }
end sub
