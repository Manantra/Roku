import "pkg:/source/api/Achievements.bs"
import "pkg:/source/utils/misc.bs"

' The panel asks for everything at once when it opens, and the leaderboard and the recap ask
' again when the viewer picks a different board or period. All of it goes over the network, so
' none of it runs on the render thread.

sub init()
    m.top.functionName = "loadAchievements"
end sub

sub loadAchievements()
    request = m.top.request
    kind = chainLookupReturn(request, "kind", "overview")

    if kind = "leaderboard"
        m.top.result = { kind: kind, entries: achievements.FetchLeaderboard(request.category) }
        return
    end if

    if kind = "recap"
        m.top.result = { kind: kind, recap: achievements.FetchRecap(request.period) }
        return
    end if

    m.top.result = { kind: "overview", overview: achievements.LoadOverview() }
end sub
