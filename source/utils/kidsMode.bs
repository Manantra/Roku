import "pkg:/source/utils/config.bs"
import "pkg:/source/utils/misc.bs"

' Kids Mode strips the app back to what a child needs and locks the way out behind a PIN.
'
' Everything the mode decides lives here, so the rules can be read in one place. The flag is kept
' in this user's registry on this Roku rather than synced, since a parent handing over the TV
' should not put their phone in Kids Mode too.

' The only rows the mode leaves standing: the way into the libraries, and what arrived in them
' lately. An allow list rather than a block list, so a row added later stays hidden until someone
' decides a child should see it. Everything else pulls from somewhere this mode cannot vouch for,
' whether that is a request queue, an outside catalogue no parental rating reaches, or the watch
' history of whoever used the account last.
const KIDS_LIBRARY_ROW = "smalllibrarytiles"
const KIDS_LATEST_ROW = "latestmedia"

' Buttons the mode takes away. A non-admin account never sees the admin one anyway, so those
' matter when the account handed over is a parent's own. The Seerr buttons open their own dialogs
' rather than moving to a screen, which puts them out of reach of the screen guard and leaves this
' set as the only thing holding them back.
const KIDS_HIDDEN_BUTTONS = ["admin", "artwork", "deleteFiles", "seerrRequest", "seerrRequest4k", "seerrWatchlist", "seerrReportIssue", "seerrManage"]

' The guide, the recordings and everything Seerr, named by the screens that draw them
const BLOCKED_SCENES = ["LiveTVLibraryView", "Schedule", "SeerrDiscoveryScreen", "SeerrRequestsScreen", "SeerrGenreBrowseScreen", "SeerrHubScreen", "SeerrIssueThread", "SeerrSettingsScreen"]

namespace kidsMode

    function Enabled() as boolean
        return get_user_setting_bool("kids.enabled", false)
    end function

    ' Whether the way out needs a PIN at all. Nothing should be able to leave the mode on without
    ' one, but if anything ever did there would be no code to check and no way to recover on a
    ' television, so the door opens rather than locking for good.
    function NeedsPin() as boolean
        return isValidAndNotEmpty(get_user_setting("kids.pinHash"))
    end function

    ' Applied on read rather than by rewriting the saved rows, so turning the mode off gives the
    ' viewer their own home screen back untouched. The mode drops the libraries entry from the
    ' navigation, so the library row is the only way into a library and it leads.
    function Sections(saved as object) as object
        kept = [KIDS_LIBRARY_ROW]
        for each name in saved
            if name = KIDS_LATEST_ROW then kept.push(name)
        end for

        return kept
    end function

    ' The guide is off limits, so the tile that leads to it is the one thing the library row
    ' loses
    function KeepLibraries(libraries as object) as object
        if not Enabled() then return libraries

        kept = []
        for each library in libraries
            if not isStringEqual(chainLookupReturn(library, "json.collectiontype", ""), "livetv") then kept.push(library)
        end for

        return kept
    end function

    ' Filtered before the viewer's own button arrangement is applied, so reordering cannot bring
    ' one of these back.
    function KeepButtons(buttons as object) as object
        if not Enabled() then return buttons

        kept = []
        for each button in buttons
            if not inArray(KIDS_HIDDEN_BUTTONS, button.id) then kept.push(button)
        end for

        return kept
    end function

    ' Screens the mode refuses to open. Hiding a way in is presentation, and a home row, a search
    ' result or the back stack reaches these without one, so the move itself has to refuse.
    function Blocked(sceneName as string) as boolean
        if not Enabled() then return false

        return inArray(BLOCKED_SCENES, sceneName)
    end function

end namespace
